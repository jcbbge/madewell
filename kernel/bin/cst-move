#!/usr/bin/env python3
"""cst-move — scaffolding for SPEC.md §2. Not the product.

Constellation is files. This performs the four legal moves and refuses everything else.
Delete it: `git mv` plus cst-gate still run the shop.

  cst-move arrive <slug>              stdin → stock/<slug>.md
  cst-move bench  <slug>              stock → bench (leaf; floor required)
  cst-move bench  <slug> --break      stock → bench/<slug>/PIECE.md
  cst-move finish <slug>              bench → finished

Stages. Does not commit. The commit is the record (SPEC.md §2).
Exit: 0 ok · 4 source gone (someone else moved it) · 5 refused · 2 usage

A line-for-line port of cst-move.c (kept beside it) so the kernel runs on any machine with
python3, which the execution door already needs; the committed binary was macOS arm64 only.
"""
import os
import subprocess
import sys

USAGE = (
    "cst-move — the four legal moves (SPEC.md §2). Scaffolding, not the product.\n"
    "\n"
    "  cst-move arrive <slug>         put a piece on the rack (stdin = title + what it's about)\n"
    "  cst-move bench  <slug>         stock → bench (leaf). Floor required.\n"
    "  cst-move bench  <slug> --break stock → bench/<slug>/PIECE.md\n"
    "  cst-move finish <slug>         bench → finished. No rewind.\n"
    "\n"
    "Stages. Does not commit. Position is still the directory.\n"
    "Exit: 0 ok · 4 source gone · 5 refused · 2 usage\n"
)

root = cst = execution_door = ""


def die(code, msg):
    sys.stderr.write("cst-move: %s\n" % msg)
    sys.exit(code)


def find_root():
    global root, cst
    probe = os.getcwd()
    while True:
        if os.path.exists(os.path.join(probe, ".git")) and os.path.exists(os.path.join(probe, ".constellation")):
            root, cst = probe, os.path.join(probe, ".constellation")
            return
        parent = os.path.dirname(probe)
        if parent == probe or probe in ("", "/"):
            die(5, "not inside a git repo with .constellation/")
        probe = parent


def bad_slug(s):
    return not s or any(c in s for c in "./@")


def run(argv):
    try:
        return subprocess.call(argv)
    except OSError:
        return 127


def git_mv(frm, to):
    if os.path.exists(execution_door):
        rc = run(["python3", execution_door, "--root", root, "--move", frm, to])
    else:
        if os.path.exists(os.path.join(cst, "sessions")):
            die(5, "execution door missing; cannot inspect bound pieces")
        rc = run(["git", "-C", root, "mv", frm, to])
    if rc != 0:
        return 4 if not os.path.exists(os.path.join(root, frm)) and not os.path.exists(frm) else 5
    return 0


def git_add(path):
    return run(["git", "-C", root, "add", "--", path])


def has_floor(path):
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return False
    want = {"**making:**": False, "**not making:**": False, "**done when:**": False, "**waits on:**": False}
    for line in lines:
        low = line.lower()
        for k in want:
            if low.startswith(k):
                want[k] = True
    return all(want.values())


def drained(rel):
    path = os.path.join(root, rel)
    try:
        return not [e for e in os.listdir(path) if not e.startswith(".")]
    except OSError:
        return True


def anywhere(slug):
    return any(os.path.exists(os.path.join(cst, p)) for p in
               ("stock/%s.md" % slug, "bench/%s.md" % slug, "bench/%s/PIECE.md" % slug, "finished/%s.md" % slug))


def cmd_arrive(slug):
    if anywhere(slug):
        die(5, "%s already exists on the rack or bench" % slug)
    path = os.path.join(cst, "stock", slug + ".md")
    rel = ".constellation/stock/%s.md" % slug
    body = "" if sys.stdin.isatty() else sys.stdin.read()
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        die(5, "%s already exists" % rel)
    except OSError as e:
        die(5, "open %s: %s" % (path, e.strerror))
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        if not body:
            f.write("# %s\n" % slug)
        else:
            f.write(body if body.endswith("\n") else body + "\n")
    if git_add(rel) != 0:
        die(5, "git add failed")
    print(rel)


def cmd_bench(slug, brk):
    src = os.path.join(cst, "stock", slug + ".md")
    src_rel = ".constellation/stock/%s.md" % slug
    if not os.path.exists(src):
        die(4, "not on the rack: %s" % src_rel)
    if not has_floor(src):
        die(5, "%s has no floor (Making / Not making / Done when / Waits on)" % src_rel)
    if brk:
        inner = os.path.join(cst, "bench", slug)
        try:
            os.makedirs(inner, exist_ok=True)
        except OSError as e:
            die(5, "mkdir %s: %s" % (inner, e.strerror))
        for st in ("stock", "bench", "finished"):
            d = os.path.join(inner, st)
            try:
                os.makedirs(d, exist_ok=True)
            except OSError as e:
                die(5, "mkdir %s: %s" % (d, e.strerror))
            open(os.path.join(d, ".gitkeep"), "a").close()
            git_add(".constellation/bench/%s/%s/.gitkeep" % (slug, st))
        dst_rel = ".constellation/bench/%s/PIECE.md" % slug
    else:
        dst_rel = ".constellation/bench/%s.md" % slug
    rc = git_mv(src_rel, dst_rel)
    if rc == 4:
        die(4, "fenced: %s is gone from the rack" % src_rel)
    if rc != 0:
        die(5, "git mv failed")
    print(dst_rel)


def cmd_finish(slug):
    leaf = os.path.join(cst, "bench", slug + ".md")
    piece = os.path.join(cst, "bench", slug, "PIECE.md")
    dst_rel = ".constellation/finished/%s.md" % slug
    if os.path.exists(leaf):
        src_rel = ".constellation/bench/%s.md" % slug
    elif os.path.exists(piece):
        if not drained(".constellation/bench/%s/stock" % slug) or not drained(".constellation/bench/%s/bench" % slug):
            die(5, "cannot finish %s — inner stock/ or bench/ is not empty" % slug)
        src_rel = ".constellation/bench/%s/PIECE.md" % slug
    else:
        die(4, "not on the bench: %s" % slug)
    rc = git_mv(src_rel, dst_rel)
    if rc == 4:
        die(4, "fenced: %s is gone from the bench" % src_rel)
    if rc != 0:
        die(5, "git mv failed")
    print(dst_rel)


def main(argv):
    global execution_door
    if len(argv) < 2:
        sys.stdout.write(USAGE)
        return 2
    find_root()
    os.chdir(root)  # the C door passed repo-relative paths from the root
    execution_door = os.path.join(cst, "bin", "cst-session.py")
    if not os.path.exists(execution_door):
        execution_door = os.path.join(os.path.dirname(os.path.realpath(argv[0])), "cst-session.py")
    cmd = argv[1]
    if cmd == "arrive":
        if len(argv) < 3 or bad_slug(argv[2]):
            die(5, "arrive needs a slug (no . @ /)")
        cmd_arrive(argv[2])
    elif cmd == "bench":
        if len(argv) < 3 or bad_slug(argv[2]):
            die(5, "bench needs a slug (no . @ /)")
        cmd_bench(argv[2], len(argv) > 3 and argv[3] == "--break")
    elif cmd == "finish":
        if len(argv) < 3 or bad_slug(argv[2]):
            die(5, "finish needs a slug (no . @ /)")
        cmd_finish(argv[2])
    else:
        sys.stdout.write(USAGE)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
