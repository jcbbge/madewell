#!/bin/sh
# mw — Made Well reference CLI.
# POSIX sh, zero dependencies beyond git + POSIX userland.
#
# Implements the subcommands called out in SPEC.md (Made Well ledger/door spec):
#   here [--json]                  current position (§4, §7.1)
#   frontier [--json]              set of legal doors (§5.3)
#   advance <door> [<item-id>]     tick the ratchet (§5, §6)
#   check <door> [<item-id>]       run door script in gauge mode (§6.3)
#   pause <surface> <redirect>     append a pause event (§3.3)
#
# Rule 1 (SPEC §1): nothing here reads or writes outside the repo.
# Rule 2 (SPEC §1): the ledger is plain text, appended here; no databases.
# The hash chain (§3.4) uses shasum -a 256 and the first 16 hex chars of the
# previous line's exact bytes (no trailing LF).

set -u

prog=mw

# ---------- usage ----------

usage() {
  cat <<USAGE
Usage:
  $prog here [--json]
  $prog frontier [--json]
  $prog advance <door> [<item-id>]
  $prog check <door> [<item-id>]
  $prog pause <surface> <redirect>
  $prog -h | --help
USAGE
}

# ---------- repo discovery ----------

find_repo() {
  d=$(pwd)
  while [ "$d" != "/" ]; do
    if [ -d "$d/.madewell" ]; then
      printf '%s\n' "$d"
      return 0
    fi
    d=$(dirname "$d")
  done
  return 1
}

repo=$(find_repo) || { echo "$prog: not in a Made Well repo (no .madewell/ found)" >&2; exit 2; }
mw_dir=$repo/.madewell
ledger=$mw_dir/work/events.jsonl
mw_json=$mw_dir/madewell.json
doors_dir=$mw_dir/bin/doors
notify_script=$mw_dir/bin/notify.sh

# ---------- helpers ----------

die() { echo "$prog: $*" >&2; exit "${2:-1}"; }
note() { echo "$prog: $*" >&2; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# First 16 hex chars of SHA-256 of stdin bytes.
shasum16() { shasum -a 256 | awk '{print substr($1,1,16)}'; }

# Compute the prev field for the next event (genesis if no prior line).
compute_prev() {
  if [ ! -s "$ledger" ]; then
    printf '%s\n' "genesis"
    return 0
  fi
  last=$(tail -n 1 "$ledger" 2>/dev/null || true)
  [ -z "$last" ] && { printf '%s\n' "genesis"; return 0; }
  printf '%s' "$last" | shasum -a 256 | awk '{print substr($1,1,16)}'
}

# Current head of the ledger (hash of the last line, or genesis).
ledger_head() {
  compute_prev
}

# Extract a JSON string field from a JSONL line.
json_field() {
  line=$1; key=$2
  printf '%s' "$line" | sed -n "s/.*\"$key\":\"\([^\"]*\)\".*/\1/p" | head -n 1
}

# JSON-quote a string for safe inclusion in a JSON string literal.
json_quote() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'
}

# Append a JSONL line to the ledger.
append_ledger() {
  printf '%s\n' "$1" >> "$ledger"
}

# Build a door event JSON line. Args: door, cycle, item, mode, result, checks_json
build_door_event() {
  door=$1; cycle=$2; item=$3; mode=$4; result=$5; checks=$6
  prev=$(compute_prev)
  ts=$(now_iso)
  actor='tool:mw'
  if [ -n "$item" ]; then
    printf '{"v":1,"ts":"%s","kind":"door","prev":"%s","actor":"%s","door":"%s","cycle":"%s","item":"%s","checks":%s,"result":"%s","mode":"%s"}' \
      "$ts" "$prev" "$actor" "$door" "$cycle" "$item" "$checks" "$result" "$mode"
  else
    printf '{"v":1,"ts":"%s","kind":"door","prev":"%s","actor":"%s","door":"%s","cycle":"%s","checks":%s,"result":"%s","mode":"%s"}' \
      "$ts" "$prev" "$actor" "$door" "$cycle" "$checks" "$result" "$mode"
  fi
}

# Build a pause event JSON line. Args: cycle, surface, redirect
build_pause_event() {
  cycle=$1; surface=$2; redirect=$3
  prev=$(compute_prev)
  ts=$(now_iso)
  actor='human:jrg'
  surface_q=$(json_quote "$surface")
  redirect_q=$(json_quote "$redirect")
  printf '{"v":1,"ts":"%s","kind":"pause","prev":"%s","actor":"%s","cycle":"%s","surface":"%s","redirect":"%s"}' \
    "$ts" "$prev" "$actor" "$cycle" "$surface_q" "$redirect_q"
}

# Run a door script. Args: door, cycle, item, mode.
# Sets global DOOR_STDOUT. Returns the script's exit code.
DOOR_STDOUT=
run_door_script() {
  door=$1; cycle=$2; item=$3; mode=$4
  script=$doors_dir/$door.sh
  if [ ! -f "$script" ]; then
    DOOR_STDOUT=""
    return 0
  fi
  DOOR_STDOUT=$(MW_LEDGER=$ledger MW_MODE=$mode \
    sh "$script" "$repo" "$cycle" "$item" 2>/dev/null)
  return $?
}

# Translate door-script stdout to a JSON array of {id,pass,msg} objects.
walls_to_json() {
  printf '%s\n' "$1" | awk '
    BEGIN { printf "["; first=1 }
    NF >= 2 {
      id=$1; pass=$2
      msg=""
      for (i=3; i<=NF; i++) msg = msg (i>3?" ":"") $i
      gsub(/\\/, "\\\\", msg)
      gsub(/"/, "\\\"", msg)
      if (!first) printf ","
      first=0
      pass_bool = (pass == "pass" ? "true" : "false")
      printf "{\"id\":\"%s\",\"pass\":%s,\"msg\":\"%s\"}", id, pass_bool, msg
    }
    END { print "]" }
  '
}

# ---------- position from ledger + madewell.json ----------

position_state() {
  if [ ! -s "$ledger" ]; then
    printf 'OPEN_CYCLE=\nPHASE=discovery\nITEM=\nCYCLE_PHASE=\nSOURCE=\n'
    return 0
  fi

  state=$(awk '
    function f(line, key,    s) {
      s = "\"" key "\":\"[^\"]*\""
      if (match(line, s)) return substr(line, RSTART+length(key)+4, RLENGTH-length(key)-5)
      return ""
    }
    {
      line = $0
      if (f(line, "kind") != "door") next
      if (f(line, "result") != "pass") next
      door = f(line, "door")
      cycle = f(line, "cycle")
      item = f(line, "item")
      if (door == "" || cycle == "") next
      if (item == "") {
        if (door == "commit") commit_count[cycle]++
        if (door == "land") land_count[cycle]++
        last_cycle_door[cycle] = door
        last_cycle_nr[cycle] = NR
      } else {
        key = cycle SUBSEP item
        last_item_door[key] = door
        last_item_nr[key] = NR
        if (!(key in seen_cycle)) {
          seen_cycle[key] = cycle
        }
      }
    }
    END {
      open_cycle = ""
      max_nr = 0
      for (c in commit_count) {
        if (commit_count[c] > land_count[c] && last_cycle_nr[c] > max_nr) {
          open_cycle = c
          max_nr = last_cycle_nr[c]
        }
      }
      print "OPEN_CYCLE=" open_cycle
      if (open_cycle != "") {
        print "CYCLE_PHASE=" last_cycle_door[open_cycle]
        inflight = ""
        inflight_nr = 0
        for (k in last_item_door) {
          if (seen_cycle[k] != open_cycle) continue
          if (last_item_door[k] == "plan") {
            if (last_item_nr[k] > inflight_nr) {
              inflight_nr = last_item_nr[k]
              split(k, parts, SUBSEP)
              inflight = parts[2]
            }
          }
        }
        print "IN_FLIGHT_ITEM=" inflight
        if (inflight != "") {
          print "IN_FLIGHT_PHASE=make"
        }
      }
    }
  ' "$ledger")

  open_cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
  cycle_phase=$(printf '%s\n' "$state" | sed -n 's/^CYCLE_PHASE=//p')
  in_flight=$(printf '%s\n' "$state" | sed -n 's/^IN_FLIGHT_ITEM=//p')

  if [ -n "$open_cycle" ] && [ -f "$mw_json" ]; then
    mw_state=$(awk -v cycle="$open_cycle" '
      {
        line = $0
        if (line ~ "\"id\"[[:space:]]*:[[:space:]]*\"" cycle "\"") {
          in_cycle = 1
        }
        if (in_cycle) {
          if (match(line, /"source"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
            s = substr(line, RSTART, RLENGTH)
            sub(/^"source"[[:space:]]*:[[:space:]]*"/, "", s)
            sub(/"$/, "", s)
            print "SOURCE=" s
          }
          # Find all i-item ids on the line
          remaining = line
          while (match(remaining, /"id"[[:space:]]*:[[:space:]]*"i[0-9]+"/)) {
            s = substr(remaining, RSTART, RLENGTH)
            sub(/^"id"[[:space:]]*:[[:space:]]*"/, "", s)
            sub(/"$/, "", s)
            if (!(s in seen)) {
              seen[s] = 1
              print "ITEM_ID=" s
            }
            remaining = substr(remaining, RSTART + RLENGTH)
          }
        }
        if (in_cycle && line ~ /^[[:space:]]*\},?[[:space:]]*$/ && NR > 2) {
          in_cycle = 0
        }
      }
    ' "$mw_json")
    source=$(printf '%s\n' "$mw_state" | sed -n 's/^SOURCE=//p' | head -n 1)
    item_ids=$(printf '%s\n' "$mw_state" | sed -n 's/^ITEM_ID=//p')
  else
    source=""
    item_ids=""
  fi

  phase=""
  if [ -z "$open_cycle" ]; then
    phase="discovery"
  else
    case "$cycle_phase" in
      commit) phase="ground" ;;
      ground)
        if [ -z "$item_ids" ]; then
          phase="land"
        else
          phase="plan"
        fi
        ;;
      *) phase="unknown" ;;
    esac
    if [ -n "$in_flight" ]; then
      phase="make"
    fi
  fi

  if [ -n "$open_cycle" ] && [ "$cycle_phase" = "ground" ] && [ -n "$item_ids" ] && [ -z "$in_flight" ]; then
    all_done=1
    for iid in $item_ids; do
      has_verify=$(awk -v c="$open_cycle" -v i="$iid" '
        $0 ~ ("\"cycle\":\"" c "\"") && $0 ~ ("\"item\":\"" i "\"") && $0 ~ /"door":"verify"/ && $0 ~ /"result":"pass"/ { found=1 }
        END { print (found ? "yes" : "no") }
      ' "$ledger")
      if [ "$has_verify" != "yes" ]; then
        all_done=0
        break
      fi
    done
    if [ "$all_done" = "1" ]; then
      phase="land"
    fi
  fi

  printf 'OPEN_CYCLE=%s\n' "$open_cycle"
  printf 'PHASE=%s\n' "$phase"
  printf 'ITEM=%s\n' "$in_flight"
  printf 'CYCLE_PHASE=%s\n' "$cycle_phase"
  printf 'SOURCE=%s\n' "$source"
}

# ---------- frontier computation ----------

frontier_doors() {
  if [ ! -f "$mw_json" ]; then
    printf '[]\n'
    return 0
  fi

  # Helper: count discovery items present
  _has_discovery() {
    awk '
      BEGIN { in_d = 0 }
      {
        line = $0
        if (in_d == 0 && line ~ /"discovery":[[:space:]]*\[/) in_d = 1
        if (in_d && line ~ /\]/) in_d = 0
        if (in_d && line ~ /"id"[[:space:]]*:[[:space:]]*"d[0-9]+"/) print
      }
    ' "$mw_json" 2>/dev/null | grep -c . || true
  }

  if [ ! -s "$ledger" ]; then
    if [ "$(_has_discovery)" -gt 0 ]; then
      printf '["commit"]\n'
    else
      printf '[]\n'
    fi
    return 0
  fi

  state=$(position_state)
  open_cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
  phase=$(printf '%s\n' "$state" | sed -n 's/^PHASE=//p')

  if [ -z "$open_cycle" ]; then
    if [ "$(_has_discovery)" -gt 0 ]; then
      printf '["commit"]\n'
    else
      printf '[]\n'
    fi
    return 0
  fi

  case "$phase" in
    ground) printf '["ground"]\n' ;;
    plan)   printf '["plan"]\n' ;;
    make)   printf '["verify"]\n' ;;
    land)   printf '["land"]\n' ;;
    *)      printf '[]\n' ;;
  esac
}

# ---------- madewell.json helpers ----------

# Get the open cycle (first in active[]).
active_cycle_info() {
  awk '
    {
      line = $0
      if (line ~ /"active":[[:space:]]*\[/) { in_active = 1; next }
      if (in_active && line ~ /^[[:space:]]*\{/) { in_obj = 1; depth = 1; obj = line "\n"; next }
      if (in_obj) {
        obj = obj line "\n"
        n = gsub(/\{/, "{", line); depth += n
        n = gsub(/\}/, "}", line); depth -= n
        if (depth <= 0) {
          in_obj = 0
          if (match(obj, /"id"[[:space:]]*:[[:space:]]*"c[0-9]+"/)) {
            s = substr(obj, RSTART, RLENGTH)
            sub(/^"id"[[:space:]]*:[[:space:]]*"/, "", s); sub(/"$/, "", s)
            print "CYCLE_ID=" s
          }
          if (match(obj, /"source"[[:space:]]*:[[:space:]]*"d[0-9]+"/)) {
            s = substr(obj, RSTART, RLENGTH)
            sub(/^"source"[[:space:]]*:[[:space:]]*"/, "", s); sub(/"$/, "", s)
            print "SOURCE=" s
          }
          remaining = obj
          while (match(remaining, /"id"[[:space:]]*:[[:space:]]*"i[0-9]+"/)) {
            s = substr(remaining, RSTART, RLENGTH)
            sub(/^"id"[[:space:]]*:[[:space:]]*"/, "", s); sub(/"$/, "", s)
            remaining = substr(remaining, RSTART + RLENGTH)
            print "ITEM_ID=" s
          }
          exit
        }
      }
      if (in_active && line ~ /^[[:space:]]*\]/) { in_active = 0 }
    }
  ' "$mw_json"
}

next_cycle_id() {
  max=0
  for c in $(grep -oE '"id"[[:space:]]*:[[:space:]]*"c[0-9]+"' "$mw_json" 2>/dev/null | sed -n 's/.*c\([0-9]*\)".*/\1/p'); do
    if [ "$c" -gt "$max" ] 2>/dev/null; then
      max=$c
    fi
  done
  printf 'c%03d\n' $((max + 1))
}

discovery_items() {
  awk '
    {
      line = $0
      if (in_disc == 0 && line ~ /"discovery":[[:space:]]*\[/) {
        in_disc = 1
        # Do not next - the same line may contain d-item ids if the
        # discovery array is on a single line.
      }
      if (in_disc && match(line, /"id"[[:space:]]*:[[:space:]]*"d[0-9]+"/)) {
        s = substr(line, RSTART, RLENGTH)
        sub(/.*"id"[[:space:]]*:[[:space:]]*"/, "", s)
        sub(/"$/, "", s)
        print s
      }
      if (in_disc && line ~ /\]/) { in_disc = 0 }
    }
  ' "$mw_json"
}

# Update the position block in madewell.json. Single-line format.
update_position_block() {
  pos=$1
  tmp=$(mktemp)
  if grep -q '"position"[[:space:]]*:' "$mw_json"; then
    sed "s|\"position\"[[:space:]]*:[[:space:]]*{[^{}]*}|\"position\":{$pos}|" "$mw_json" > "$tmp"
  else
    sed "s|^} *$|\"position\":{$pos}\n}|" "$mw_json" > "$tmp"
  fi
  mv "$tmp" "$mw_json"
}

# Normalize a JSON snippet to a single line (collapse whitespace).
_json_single_line() {
  printf '%s' "$1" | tr -d '\n' | sed -e 's/[[:space:]]\{1,\}/ /g' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//'
}

# Find the line range of the d-item block in madewell.json.
# Returns: "start_line end_line" (the lines containing the opening { and closing }
# of the d-item object). Uses a stack of object start lines.
_ditem_range() {
  did=$1
  awk -v d="$did" '
    BEGIN { depth = 0; in_d = 0 }
    {
      line = $0
      n_open = gsub(/\{/, "{", line)
      n_close = gsub(/\}/, "}", line)
      for (i = 0; i < n_open; i++) {
        depth++
        stack[depth] = NR
      }
      if (in_d == 0 && depth >= 1 && match(line, "\"id\"[[:space:]]*:[[:space:]]*\"" d "\"")) {
        in_d = 1
        d_start = stack[depth]
        d_obj_depth = depth
      }
      for (i = 0; i < n_close; i++) {
        if (in_d == 1 && depth == d_obj_depth) {
          print d_start, NR
          exit
        }
        depth--
      }
    }
  ' "$mw_json"
}

# Find the line range of the c-cycle block in active[].
_cycle_range() {
  cyc=$1
  awk -v c="$cyc" '
    BEGIN { in_active = 0; depth = 0; in_c = 0 }
    {
      line = $0
      if (in_active == 0 && line ~ /"active"[[:space:]]*:[[:space:]]*\[/) {
        in_active = 1
        next
      }
      if (in_active) {
        n_open = gsub(/\{/, "{", line)
        n_close = gsub(/\}/, "}", line)
        for (i = 0; i < n_open; i++) {
          depth++
          stack[depth] = NR
        }
        if (in_c == 0 && depth >= 1 && match(line, "\"id\"[[:space:]]*:[[:space:]]*\"" c "\"")) {
          in_c = 1
          c_start = stack[depth]
          c_obj_depth = depth
        }
        for (i = 0; i < n_close; i++) {
          if (in_c == 1 && depth == c_obj_depth) {
            print c_start, NR
            exit
          }
          depth--
        }
        if (line ~ /^[[:space:]]*\]/) { in_active = 0 }
      }
    }
  ' "$mw_json"
}

apply_commit() {
  new_cycle=$1
  first_did=$(discovery_items | head -n 1)
  [ -z "$first_did" ] && die "no discovery items to commit"

  range=$(_ditem_range "$first_did")
  if [ -z "$range" ]; then
    die "discovery item $first_did not found in madewell.json"
  fi
  start=${range% *}
  end=${range#* }

  # Extract items array (the value of the "items" key) as a multi-line snippet
  items_raw=$(sed -n "${start},${end}p" "$mw_json" | \
    awk '
      BEGIN { in_items = 0; depth = 0 }
      /"items"[[:space:]]*:[[:space:]]*\[/ {
        idx = index($0, "[")
        if (idx > 0) {
          sub_str = substr($0, idx)
          print sub_str
          in_items = 1
          n_open = gsub(/\[/, "[", sub_str)
          n_close = gsub(/\]/, "]", sub_str)
          depth = n_open - n_close
          if (depth <= 0) { in_items = 0; exit }
          next
        }
      }
      in_items {
        print
        n_open = gsub(/\[/, "[", $0)
        n_close = gsub(/\]/, "]", $0)
        depth += n_open - n_close
        if (depth <= 0) { in_items = 0; exit }
      }
    ')
  items_field=$(_json_single_line "$items_raw")
  [ -z "$items_field" ] && items_field="[]"

  c_entry="{\"id\":\"$new_cycle\",\"source\":\"$first_did\",\"items\":$items_field}"

  # Mutate the file: delete the d-item block, insert the c-cycle into active[].
  tmp=$(mktemp)
  awk -v s="$start" -v e="$end" -v entry="$c_entry" '
    BEGIN { in_inserted = 0 }
    {
      line = $0
      if (NR >= s && NR <= e) { next }
      # Insert c-cycle into active[]
      if (in_inserted == 0 && line ~ /"active"[[:space:]]*:[[:space:]]*\[/) {
        if (match(line, /"active"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]/)) {
          sub(/\[[[:space:]]*\]/, "[\n  " entry "\n]", line)
          in_inserted = 1
          print line
          next
        }
        print line
        if ((getline next_line) > 0) {
          stripped = next_line
          sub(/^[[:space:]]*/, "", stripped)
          sub(/[[:space:]]*,?[[:space:]]*$/, "", stripped)
          if (stripped == "]") {
            print "  " entry
          } else {
            print "  " entry ","
          }
          print next_line
        }
        in_inserted = 1
        next
      }
      print line
    }
  ' "$mw_json" > "$tmp"
  mv "$tmp" "$mw_json"
}

apply_land() {
  cycle=$1

  range=$(_cycle_range "$cycle")
  if [ -z "$range" ]; then
    die "cycle $cycle not found in active[]"
  fi
  start=${range% *}
  end=${range#* }
  cycle_entry=$(_json_single_line "$(sed -n "${start},${end}p" "$mw_json")")
  [ -z "$cycle_entry" ] && die "could not extract cycle entry"

  tmp=$(mktemp)
  awk -v s="$start" -v e="$end" -v entry="$cycle_entry" '
    BEGIN { in_inserted = 0 }
    {
      line = $0
      if (NR >= s && NR <= e) { next }
      if (in_inserted == 0 && line ~ /"landed"[[:space:]]*:[[:space:]]*\[/) {
        if (match(line, /"landed"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]/)) {
          sub(/\[[[:space:]]*\]/, "[\n  " entry "\n]", line)
          in_inserted = 1
          print line
          next
        }
        print line
        if ((getline next_line) > 0) {
          stripped = next_line
          sub(/^[[:space:]]*/, "", stripped)
          sub(/[[:space:]]*,?[[:space:]]*$/, "", stripped)
          if (stripped == "]") {
            print "  " entry
          } else {
            print "  " entry ","
          }
          print next_line
        }
        in_inserted = 1
        next
      }
      print line
    }
  ' "$mw_json" > "$tmp"
  mv "$tmp" "$mw_json"
}

# ---------- notify hook (fire-and-forget) ----------

notify() {
  line=$1
  if [ ! -f "$notify_script" ]; then
    return 0
  fi
  (
    printf '%s\n' "$line" | MW_REPO_ROOT=$repo sh "$notify_script" >/dev/null 2>&1 &
    pid=$!
    ( sleep 3; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
    wait $pid 2>/dev/null
  ) >/dev/null 2>&1 &
  return 0
}

# ---------- subcommands ----------

do_here() {
  json=0
  [ "${1:-}" = "--json" ] && json=1

  head=$(ledger_head)
  state=$(position_state)
  open_cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
  phase=$(printf '%s\n' "$state" | sed -n 's/^PHASE=//p')
  item=$(printf '%s\n' "$state" | sed -n 's/^ITEM=//p')
  source=$(printf '%s\n' "$state" | sed -n 's/^SOURCE=//p')

  if [ -z "$open_cycle" ]; then
    stage="discovery"
  else
    stage="build"
  fi

  ts=$(now_iso)

  if [ "$json" = "1" ]; then
    if [ -n "$item" ]; then
      printf '{"head":"%s","stage":"%s","cycle":"%s","source":"%s","item":"%s","phase":"%s","ts":"%s"}\n' \
        "$head" "$stage" "$open_cycle" "$source" "$item" "$phase" "$ts"
    elif [ -n "$open_cycle" ]; then
      printf '{"head":"%s","stage":"%s","cycle":"%s","source":"%s","phase":"%s","ts":"%s"}\n' \
        "$head" "$stage" "$open_cycle" "$source" "$phase" "$ts"
    else
      printf '{"head":"%s","stage":"%s","phase":"%s","ts":"%s"}\n' \
        "$head" "$stage" "$phase" "$ts"
    fi
  else
    if [ -n "$item" ]; then
      printf 'head:     %s\nstage:    %s\ncycle:    %s\nsource:   %s\nitem:     %s\nphase:    %s\nts:       %s\n' \
        "$head" "$stage" "$open_cycle" "$source" "$item" "$phase" "$ts"
    elif [ -n "$open_cycle" ]; then
      printf 'head:     %s\nstage:    %s\ncycle:    %s\nsource:   %s\nphase:    %s\nts:       %s\n' \
        "$head" "$stage" "$open_cycle" "$source" "$phase" "$ts"
    else
      printf 'head:     %s\nstage:    %s\nphase:    %s\nts:       %s\n' \
        "$head" "$stage" "$phase" "$ts"
    fi
  fi
}

do_frontier() {
  json=0
  [ "${1:-}" = "--json" ] && json=1

  if [ "$json" = "1" ]; then
    frontier_doors
  else
    frontier_doors | sed 's/[]"[,]//g; s/^[[:space:]]*//; s/[[:space:]]*$//' | tr '\n' ' '
    printf '\n'
  fi
}

legality_check() {
  door=$1; item_id=$2

  state=$(position_state)
  open_cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
  phase=$(printf '%s\n' "$state" | sed -n 's/^PHASE=//p')
  in_flight=$(printf '%s\n' "$state" | sed -n 's/^ITEM=//p')

  case "$door" in
    commit)
      if [ -n "$open_cycle" ]; then
        echo "cycle $open_cycle is still open; land it first"
        return 1
      fi
      if [ -z "$(discovery_items)" ]; then
        echo "no discovery items to commit"
        return 1
      fi
      ;;
    ground)
      if [ -z "$open_cycle" ]; then
        echo "no open cycle; commit first"
        return 1
      fi
      if [ "$phase" != "ground" ]; then
        echo "ground already passed for cycle $open_cycle (current phase: $phase)"
        return 1
      fi
      ;;
    plan)
      if [ -z "$open_cycle" ]; then
        echo "no open cycle; commit first"
        return 1
      fi
      if [ "$phase" != "plan" ] && [ "$phase" != "ground" ]; then
        echo "plan not legal in phase $phase (cycle $open_cycle)"
        return 1
      fi
      if [ -z "$item_id" ]; then
        echo "plan requires an item-id"
        return 1
      fi
      # Check item exists in cycle
      item_in_queue=$(active_cycle_info | grep -c "^ITEM_ID=$item_id$" || true)
      if [ "$item_in_queue" -eq 0 ]; then
        echo "item $item_id is not in the open cycle's queue"
        return 1
      fi
      # Check no item is currently in flight (must verify before planning next)
      if [ -n "$in_flight" ]; then
        echo "item $in_flight is still in flight; verify it first"
        return 1
      fi
      # Check that the requested item is the next unplanned item
      active_cycle_info | sed -n 's/^ITEM_ID=//p' | while read -r qitem; do
        already=$(awk -v c="$open_cycle" -v i="$qitem" '
          $0 ~ ("\"cycle\":\"" c "\"") && $0 ~ ("\"item\":\"" i "\"") && $0 ~ /"door":"plan"/ && $0 ~ /"result":"pass"/ { found=1 }
          END { print (found ? "yes" : "no") }
        ' "$ledger")
        if [ "$already" = "no" ]; then
          if [ "$qitem" != "$item_id" ]; then
            echo "cannot skip: $qitem is the next item to plan"
            return 1
          fi
          return 0
        fi
      done
      ;;
    verify)
      if [ -z "$open_cycle" ]; then
        echo "no open cycle; commit first"
        return 1
      fi
      if [ -z "$item_id" ]; then
        echo "verify requires an item-id"
        return 1
      fi
      if [ "$phase" != "make" ] || [ "$in_flight" != "$item_id" ]; then
        echo "item $item_id is not in flight (phase=$phase in_flight=$in_flight)"
        return 1
      fi
      has_plan=$(awk -v c="$open_cycle" -v i="$item_id" '
        $0 ~ ("\"cycle\":\"" c "\"") && $0 ~ ("\"item\":\"" i "\"") && $0 ~ /"door":"plan"/ && $0 ~ /"result":"pass"/ { found=1 }
        END { print (found ? "yes" : "no") }
      ' "$ledger")
      if [ "$has_plan" != "yes" ]; then
        echo "item $item_id has no plan pass event"
        return 1
      fi
      ;;
    land)
      if [ -z "$open_cycle" ]; then
        echo "no open cycle; commit first"
        return 1
      fi
      if [ "$phase" != "land" ]; then
        echo "land not yet legal: phase is $phase"
        return 1
      fi
      ;;
    *)
      echo "unknown door: $door"
      return 1
      ;;
  esac
  return 0
}

do_advance() {
  door=${1:-}
  item_id=${2:-}
  [ -z "$door" ] && { usage >&2; die "advance requires <door>"; }

  if err=$(legality_check "$door" "$item_id"); then
    :
  else
    die "refuse: $err"
  fi

  if [ "$door" = "commit" ]; then
    new_cycle=$(next_cycle_id)
    cycle=$new_cycle
  else
    state=$(position_state)
    cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
  fi

  run_door_script "$door" "$cycle" "$item_id" "gate"
  script_rc=$?
  checks=$(walls_to_json "$DOOR_STDOUT")

  if [ "$script_rc" = "0" ]; then
    result="pass"
  else
    result="fail"
  fi

  if [ "$script_rc" = "0" ]; then
    case "$door" in
      commit) apply_commit "$cycle" ;;
      land)   apply_land "$cycle" ;;
    esac
  fi

  event=$(build_door_event "$door" "$cycle" "$item_id" "gate" "$result" "$checks")
  append_ledger "$event"

  pos_state=$(position_state)
  p_phase=$(printf '%s\n' "$pos_state" | sed -n 's/^PHASE=//p')
  p_cycle=$(printf '%s\n' "$pos_state" | sed -n 's/^OPEN_CYCLE=//p')
  p_item=$(printf '%s\n' "$pos_state" | sed -n 's/^ITEM=//p')
  p_source=$(printf '%s\n' "$pos_state" | sed -n 's/^SOURCE=//p')
  p_head=$(ledger_head)
  if [ -n "$p_item" ]; then
    pos="\"stage\":\"build\",\"cycle\":\"$p_cycle\",\"source\":\"$p_source\",\"item\":\"$p_item\",\"phase\":\"$p_phase\",\"head\":\"$p_head\""
  elif [ -n "$p_cycle" ]; then
    pos="\"stage\":\"build\",\"cycle\":\"$p_cycle\",\"source\":\"$p_source\",\"phase\":\"$p_phase\",\"head\":\"$p_head\""
  else
    pos="\"stage\":\"discovery\",\"phase\":\"$p_phase\",\"head\":\"$p_head\""
  fi
  update_position_block "$pos"

  notify "$event"

  if [ "$result" = "pass" ]; then
    echo "$prog: $door pass — $checks"
    exit 0
  else
    note "$door fail — $checks"
    exit 1
  fi
}

do_check() {
  door=${1:-}
  item_id=${2:-}
  [ -z "$door" ] && { usage >&2; die "check requires <door>"; }

  if [ "$door" != "commit" ]; then
    state=$(position_state)
    cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
    if [ -z "$cycle" ]; then
      cycle=$(active_cycle_info | sed -n 's/^CYCLE_ID=//p' | head -n 1)
    fi
    if [ -z "$cycle" ]; then
      die "no cycle available to check $door"
    fi
  else
    cycle="check"
  fi

  run_door_script "$door" "$cycle" "$item_id" "gauge"
  script_rc=$?

  if [ -n "$DOOR_STDOUT" ]; then
    printf '%s\n' "$DOOR_STDOUT"
  else
    printf '%s pass (declarative door; no script)\n' "$door"
  fi
  exit $script_rc
}

do_pause() {
  surface=${1:-}
  redirect=${2:-}
  [ -z "$surface" ] && { usage >&2; die "pause requires <surface> and <redirect>"; }
  [ -z "$redirect" ] && { usage >&2; die "pause requires <redirect>"; }

  state=$(position_state)
  cycle=$(printf '%s\n' "$state" | sed -n 's/^OPEN_CYCLE=//p')
  if [ -z "$cycle" ]; then
    cycle=$(grep -oE '"id":"c[0-9]+"' "$mw_json" 2>/dev/null | sed 's/.*"c\([0-9]*\)".*/c\1/' | sort | tail -n 1)
  fi
  cycle=${cycle:-none}

  event=$(build_pause_event "$cycle" "$surface" "$redirect")
  append_ledger "$event"

  notify "$event"

  echo "$prog: pause recorded"
}

# ---------- main ----------

subcmd=${1:-}
[ $# -gt 0 ] && shift 2>/dev/null || true

case "$subcmd" in
  here) do_here "$@" ;;
  frontier) do_frontier "$@" ;;
  advance) do_advance "$@" ;;
  check) do_check "$@" ;;
  pause) do_pause "$@" ;;
  -h|--help|help|"") usage; exit 0 ;;
  *) usage >&2; die "unknown subcommand: $subcmd" ;;
esac
