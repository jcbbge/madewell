{
  "name": "madewell-pi-durable",
  "version": "0.3.0",
  "description": "Made Well on Pi Durable: durable work, separate pi agents per phase",
  "files": [
    "*.mjs",
    "pi-extension.ts",
    "harness/",
    "prescriptions.json",
    "FOLD.md",
    "DISPATCH.md",
    "PROVISION.md",
    "FOUNDATION.md",
    "AGENTS.md",
    "README.md",
    "dashboard.html"
  ],
  "pi": {
    "extensions": [
      "./pi-extension.ts"
    ]
  },
  "private": true,
  "bin": {
    "pi-durable": "cli.mjs"
  },
  "type": "module",
  "scripts": {
    "setup": "node provision.mjs",
    "test": "PI_DURABLE_ALERT=none PI_DURABLE_CLAUDE=/bin/false PI_DURABLE_CODEX=/bin/false node --test test/*.test.mjs",
    "update": "npm install --no-save @earendil-works/pi-durable@latest @earendil-works/pi-ai@latest @earendil-works/chord@latest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "latest",
    "@earendil-works/pi-durable": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*"
  }
}
