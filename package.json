{
  "name": "madewell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mw": "dist/mw.mjs"
  },
  "files": [
    "dist/mw.mjs",
    "prescriptions.json"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24.15 --outfile=dist/mw.mjs --log-level=warning",
    "pretest": "npm run bundle",
    "test": "env $(env | grep -o '^MW_[A-Z_]*' | sed 's/^/-u /') node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "effect": "^4.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
